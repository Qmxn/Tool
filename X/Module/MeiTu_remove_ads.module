#!name=美图秀秀去广告
#!desc=移除开屏广告、横幅推广，精简我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.posters\.meitu\.com\/common\/init\.json 'delpaths([["data","vip"]])'

[MITM]
hostname = %APPEND% api.posters.meitu.com
