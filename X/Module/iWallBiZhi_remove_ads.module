#!name=最美壁纸去广告
#!desc=移除悬浮广告、横幅广告、轮播图广告，精简我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Map Local]
(?i)^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.fzxhmy\.com\/tone\/trending\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除首页广告配置 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/core\/initialize\?, script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/core_initialize.js, requires-body=true
移除首页轮播图广告 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/landing\/initialize\?, script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/landing_initialize.js, requires-body=true
移除头像页横幅跳转 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/avatar\/landing\?, script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/landing.js, requires-body=true

[MITM]
hostname = %APPEND% api.fzxhmy.com
