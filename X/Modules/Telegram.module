#!name=Telegram
#!desc=Telegram外部链接跳转，可选择Telegram、Swiftgram、Turrit、iMe、Nicegram、Lingogram。
#!icon=https://github.com/Qmxn/Box/raw/X/icon/icon/XD.png

[Script]

[Telegram]t.me重定向 = type=http-response, pattern=(https:\/\/)?t\.me\/(.+), script-path=https://raw.githubusercontent.com/sooyaaabo/Loon/main/Script/Telegram/t.me_redirect.js, argument=[{{{t.me_redirect}}}]

[MITM]
hostname = %APPEND% t.me
