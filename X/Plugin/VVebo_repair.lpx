#!name=VVebo时间线修复
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/users\/show\?/i then script("https://kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js") with tag="修复时间线"
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js") with tag="修复时间线"
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js") with tag="修复时间线"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js") with tag="修复时间线", requires_body=true
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js") with tag="修复我的页面", requires_body=true

[MitM]
hostname=api.weibo.cn
