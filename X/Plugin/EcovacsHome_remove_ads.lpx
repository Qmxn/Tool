[Rewrite]
^https:\/\/gl-cn-api\.ecovacs\.cn\/v3\/private\/ response-body-json-jq '.data.navigateInfoResponseList |= map(select(.positionType == "Robot" or .positionType == "Mine"))'
^https:\/\/api-app\.dc-cn\.cn\.ecouser\.net\/api\/ecms\/app\/ad\/ reject-dict
^https:\/\/gl-cn-api\.ecovacs\.cn\/v1\/private\/ reject-dict

[MitM]
hostname=gl-cn-api.ecovacs.cn, api-app.dc-cn.cn.ecouser.net
