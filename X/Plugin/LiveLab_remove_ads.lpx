#!name=纷玩岛去广告
#!desc=移除开屏广告、弹窗广告、信息横幅推广、票夹页面横幅广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/api\.livelab\.com\.cn\/pgc\/advert\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.livelab\.com\.cn\/search\/appHotWords\/app\/queryHotWords$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.livelab\.com\.cn\/appShow\/hotSearch\/app\/rankList$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.livelab\.com\.cn\/appShow\/app\/homepage\/banners\?bannerModuleId=(82|84|53)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.livelab\.com\.cn\/appShow\/app\/homepage\/modules\?tabId=5$/i then response.json.jq(".data |= map(select(.id | IN(51, 52, 81, 82, 83, 84)))")

[MitM]
hostname=api.livelab.com.cn
