#!name=美柚去广告
#!desc=移除开屏广告、弹窗推广和信息流推广，移除青少年模式弹窗和我的页面推广。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rule]
DOMAIN, ad.seeyouyima.com, REJECT
DOMAIN, axxd.xmseeyouyima.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/circle\.(xm)?seeyouyima\.com\/v\d\/article_recommend\?/i then reject(404)
response if ${url} ~= /^https:\/\/common\.seeyouyima\.com\/v2\/conf_list$/i then response.json.delete("data.confList.Minor_mode_card")

[MitM]
hostname=circle.seeyouyima.com, circle.xmseeyouyima.com, common.seeyouyima.com
