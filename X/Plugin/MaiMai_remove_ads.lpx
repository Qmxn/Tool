#!name=脉脉去广告
#!desc=移除开屏广告、信息流广告、横幅推广、相关帖子推荐。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/adshow\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/pay\/v5\/check_gift\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/go_gossip_darwin\/external\/v2\/query_flow_cards\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/feed\/v6\/detail_recommend_feeds\?/i then response.json.delete("feeds")

[Script]
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/(feed|gossip)\/v\d\/(focus_feed|gossip_detail_comment|feed_detail_comment?)\?/i then script("https://kelee.one/Resource/JavaScript/MaiMai/MaiMai_remove_ads.js") with tag="移除信息流和评论区大块广告", requires_body=true

[MitM]
hostname=open.taou.com, h3.open.taou.com
