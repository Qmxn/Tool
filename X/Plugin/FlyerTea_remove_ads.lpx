#!name=飞客去广告
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=advis/i then reject(404)
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=vip_coupon/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ptf\.flyertrip\.com\/static\/img\/common\/ic_plate_mine_button\.png/i then reject_img(200)
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?version=5/i then script("https://kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js") with tag="移除板块广告", requires_body=true
response if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=plugin&id=k_misign:sign/i then script("https://kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js") with tag="移除签到弹窗广告", requires_body=true

[MitM]
hostname=www.flyert.com.cn, ptf.flyertrip.com
