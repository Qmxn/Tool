#!name = 小宇宙
#!desc = 过滤小宇宙广告
#!icon=https://github.com/Qmxn/Box/raw/X/icon/icon/XD.png

[Rewrite]
^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/category\/list-daily reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/related-podcast\/list$ response-body-json-jq '.data=[]'
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list response-body-json-jq '.data |= map(select(.type != "DISCOVERY_HEADER" and .type != "DISCOVERY_BANNER" and .type != "DISCOVERY_COVER_BANNER"))'

[Script]

[MitM]
hostname = api.xiaoyuzhoufm.com
