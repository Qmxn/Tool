[Rewrite]
^https:\/\/api\.58moto\.com\/advert\/ reject-dict
^https:\/\/api\.58moto\.com\/mall\/goods\/self\/list\? reject-dict
^https:\/\/api\.58moto\.com\/mall\/goods\/self\/homeList\? reject-dict
^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do$ reject-dict
^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22025 mock-response-body data-type=json data="{"code":0,"msg":"success"}" status-code=200
^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22038 mock-response-body data-type=json data="{"code":0,"msg":"success"}" status-code=200
^https:\/\/api\.58moto\.com\/forum\/public\/labelController\.do\?action=20112 mock-response-body data-type=json data="{"code":0,"msg":"success"}" status-code=200
^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22004 response-body-json-del data.link

[Script]
