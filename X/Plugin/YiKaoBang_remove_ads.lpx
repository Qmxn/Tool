#!name=医考帮去广告
#!desc=移除横幅推广、弹窗、首页悬浮挂件。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/api\.yikaobang\.com\.cn\/index\.php\/client\/main\/ads\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.yikaobang\.com\.cn\/index\.php\/client\/Main\/startPage\?/i then reject_dict(200)

[MitM]
hostname=api.yikaobang.com.cn
