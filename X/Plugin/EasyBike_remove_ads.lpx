[Script]
response if ${url} ~= /^https:\/\/mobileconfig-gateway\.hellobike\.com\/api$/i then script("https://kelee.one/Resource/JavaScript/EasyBike/mobileconfig-gateway.js") with tag="去广告", requires_body=true

[MitM]
hostname=mobileconfig-gateway.hellobike.com
