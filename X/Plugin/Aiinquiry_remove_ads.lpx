#!name=爱企查去广告
#!desc=移除开屏广告、应用内弹窗、首页轮播图、悬浮部件、信息流和搜索填充词。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/bannerPicAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/getPopConfigAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/getHotTopicAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/getNewsReportAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/getExpertVideoAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/apps\/getHotRecommendV2Ajax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/m\/getLoginWordsAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/getAppPopSettingAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/app\/commonstatusAjax/i then reject(404)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/apps\/getHomeMonitorDataAjax/i then reject_dict(200)
request if ${url} ~= /^https:\/\/aiqicha\.baidu\.com\/apps\/searchRecommendAjax/i then reject_dict(200)

[MitM]
hostname=aiqicha.baidu.com
