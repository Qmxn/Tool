#!name=有道翻译官去广告
#!desc=移除开屏广告、横幅推广，精简首页。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/gorgon\.youdao\.com\/gorgon\/v2\/request\.s/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gorgon\.youdao\.com\/gorgon\/brand\/prefetch\.s/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gorgon\.youdao\.com\/gorgon\/request\.s/i then reject_dict(200)
request if ${url} ~= /^https:\/\/fanyiguan-server\.youdao\.com\/server\/banner\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/dict\.youdao\.com\/vip\/activity\/fanyiguan\/sevendayfree\/imei\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/dict\.youdao\.com\/wordbook\/recommend\?all=false/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-overmind\.youdao\.com\/openapi\/get\/luna\/dict\/trans_abtest\/online\/iOS\?/i then reject_dict(200)

[MitM]
hostname=gorgon.youdao.com, fanyiguan-server.youdao.com, api-overmind.youdao.com, dict.youdao.com
