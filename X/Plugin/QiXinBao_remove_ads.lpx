#!name=启信宝去广告
#!desc=移除开屏广告、应用内弹窗、首页轮播图、悬浮部件和个性化推荐信息流。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/appc\.qixin\.com\/v4\/general\/getSearchPlaceholderRedirect$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/general\/getAppFloatAd$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/general\/getAppBanners$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/user\/getUserActivitys$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/enterprise\/homePageRecommend\/recommendCard\d+/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/user\/getRecommendPersons$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/enterprise\/getRecommendEnts$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/enterprise\/getRecommendation$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appc-v6\.qixin\.com\/v4\/general\/getAppBottomBanners$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/qxb-minicode-pic-osscache\.qixin\.com\/web\//i then reject(404)

[Script]

[MitM]
hostname=appc.qixin.com, appc-v6.qixin.com, qxb-minicode-pic-osscache.qixin.com
