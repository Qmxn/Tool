#!name=百度地图去广告
#!desc=移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content/i then response.json.delete("data")
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\?/i then response.json.delete("content.multi_data")
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\?/i then response.json.replace("data", "{}")
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads&type=user_home_new_service/i then response.json.delete("ads")
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\?/i then response.json.delete(["Result.cards[1]", "Result.cards[4]", "Result.cards[5]", "Result.cards[9]"])

[MitM]
hostname=afd.baidu.com, newclient.map.baidu.com, yongche.baidu.com, ecom.map.baidu.com
