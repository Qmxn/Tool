#!name=联掌门户去广告
#!desc=移除开屏广告、弹窗，移除首页、服务和发现页面无用内容。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/lzmh\.lz-qs\.com:6025\/lzmh_app_api\/api\/v1\/app3rd\/getApp3rdGenreList\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/lzmh\.lz-qs\.com:6025\/lzmh_app_api\/api\/v1\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com:9220\/mssp-api\/api\/v1\/mrtb\/getAdSlotList$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com:9220\/mssp-api\/api\/v1\/mrtb\/requestAd$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com:9220\/mssp-api\/api\/v1\/mrtb\/getSdkStartConfigList$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/lzmh\.lz-qs\.com:6025\/lzmh_app_api\/api\/v1\/index\/getRecommendList\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com\/lzmh_app_api\/o2o\/api\/v2\/o2o\/homeInfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com\/lzmh_app_api\/o2o\/api\/v2\/o2o\/homeShopList$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yuudnn\.lz-qs\.com:9220\/mssp-api\/api\/v1\/mrtb\/getSdkAdSlotList$/i then reject_dict(200)
request if ${url} ~= /^http:\/\/lzmh\.lz-qs\.com:5090\/resource\/download\//i then reject(404)
response if ${url} ~= /^https:\/\/lzmh\.lz-qs\.com:6025\/lzmh_app_api\/api\/v2\/user\/getUserBaseInfoAndConfig\?/i then response.json.delete("value.config")

[MitM]
hostname=lzmh.lz-qs.com, yuudnn.lz-qs.com
