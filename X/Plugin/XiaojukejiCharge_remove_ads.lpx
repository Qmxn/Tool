#!name=小桔充电去广告
#!desc=移除横幅广告、弹窗广告，精简我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/energy\/hummer\/api\/resource\/display($|\?)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/am\/marketing\/api\/member\/facade\/charge\/personal\/center\?/i then response.json.delete("data")
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/lego\/api\/orderSprint\/stair\/info($|\?)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/station-api\/search\/preWords$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/am\.didistatic\.com\/static\/am\/cf-terminal\/epower\/epower-thanos-app\/\d+\.\d+\.\d+\/pages\/people\/index\.js$/i then response.body.mock_file("text", "https://kelee.one/Resource/JavaScript/XiaojukejiCharge/XiaojukejiCharge_remove_ads.js", 200)

[MitM]
hostname=energy.xiaojukeji.com, am.didistatic.com
