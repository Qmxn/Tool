#!name=WARP节点查询
#!desc=显示WARP节点的详细信息，请在所有节点页面选择一个节点长按，出现菜单后进行测试。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Script]
generic then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.panel.js") with tag="WARP · INFO", img_url="icloud.circle.system", timeout=10

[MitM]
hostname=api.cloudflareclient.com, zero-trust-client.cloudflareclient.com
