#!name=胖乖生活去广告
#!desc=移除开屏广告、横幅轮播图、网格广告、信息流广告、浮窗广告，精简我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/slot\/get$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/appTitle\/get$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/local-life\/tab-order$/i then response.json.replace("data", "[]")
response if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsCategoryList$/i then response.json.replace("data", "[]")
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/integralRecord\/integralDailStatistics$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/local-life\/category$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsPage$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/userapi\.qiekj\.com\/task\/list$/i then reject_dict(200)

[MitM]
hostname=userapi.qiekj.com
