#!name=掌上无畏契约去广告
#!desc=移除开屏广告、弹窗推广、搜索热搜、搜索热榜。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/recommend\/platflashbox\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/mlol_news\/search\/varcache_hotV\d\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/customize_search\/article_rank_tab\?/i then reject_dict(200)

[MitM]
hostname=app.mval.qq.com
