[Rewrite]
response if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/mp-dolphin\/v\d\/rec\/recByPositions\?/i then response.json.jq(".info.data |= map(if .materials and (.materials | type) == \"array\" then .materials |= map(select(has(\"adPosition\") | not)) else . end)")
response if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/mp-dolphin\/v\d\/rec\/recByPositions\?/i then response.json.jq(".info.data |= map(if .materials and (.materials | type) == \"array\" then .materials |= map(select((keys | length) != 2 or (keys | sort) != [\"link\", \"pic\"])) else . end)")
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/taqu-homepage\/v\d\/Banner\/getBannerByPositions\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/bbs\/v5\/Home\/getHomePageModulesBySortV\d\?/i then response.json.jq("(.info.data.modules_list // []) |= [.[] | [.[] | del(.relaction_title, .scrollow_contents)]] | (.info.data.top_fix_list // []) |= [.[] | del(.subtitle_list)]")
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/bbs\/v5\/Guide\/photoGuide\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/i\/v\d\/homepage\/completeGuideV\d\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/i\/v\d\/asset\/toast\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/bbs\/v5\/Sign\/getDailySigninInfoV4\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/taqu-hichat\/v\d\/Hichat\/getRecommendInfo\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/live_api\/v\d\/Banner\/getBannerListV\d\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/live_api\/v\d\/HallScroll\/getList\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/taqu-msg-guide\/v\d\/RecommendColumn\/getList\?/i then reject_dict(200)

