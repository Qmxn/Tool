#!name=收银通商户端去广告
#!desc=移除开屏广告和首页推广
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/XD.png

[Rewrite]
request if ${url} ~= /^https:\/\/syt\.leshuazf\.com\/merchant\/merchant\/showOpenScreenAd$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.fqfin\.cn\/cls\/leshuapay\/preCredit\.json$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/syt\.leshuazf\.com\/merchant\/messageCenter\/stationLetterList$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/syt\.leshuazf\.com\/merchant\/merchant\/getBannerConfig$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/syt\.leshuazf\.com\/merchant\/popup\/getPopupInfo$/i then reject_dict(200)

[MitM]
hostname=syt.leshuazf.com, m.fqfin.cn
