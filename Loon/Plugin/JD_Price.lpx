#!name=京东比价
#!desc=首次使用需安装慢慢买应用，之后点击进入[我的]页面以捕获Cookie，捕获成功后方可在商品详情页面查看比价内容。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://kelee.one/Resource/JavaScript/JD/JD_Price.js") with tag="捕获令牌", timeout=10, requires_body=true
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://kelee.one/Resource/JavaScript/JD/JD_Price.js") with tag="京东比价", timeout=10, requires_body=true

[MitM]
hostname=in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
