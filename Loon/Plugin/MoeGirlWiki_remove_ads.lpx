#!name=萌娘百科去广告
#!desc=移除开屏广告、弹窗、首页横幅。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/grpc\.moegirl\.org\.cn\/moegirl\.moepad\.MoepadAppMetaService\/GetAppInitialInfo$/i then reject(404)
request if ${url} ~= /^https:\/\/grpc\.moegirl\.org\.cn\/moegirl\.moepad\.MoepadService\/GetLaunchAdPage$/i then reject(404)
request if ${url} ~= /^https:\/\/grpc\.moegirl\.org\.cn\/moegirl\.moepad\.MoepadService\/GetFeedAdProbability$/i then reject(404)

[MitM]
hostname=grpc.moegirl.org.cn
