#!name=飞猪旅行去广告
#!desc=移除开屏广告、精简我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.allresource\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.predict\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.tripzoo\.new\.couponlist\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.my\.recommendcard\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.recommend\.common\.guess\.tab\.feeds\//i then reject_dict(200)

[MitM]
hostname=acs.m.taobao.com
