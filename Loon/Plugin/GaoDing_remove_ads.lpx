#!name=稿定设计去广告
#!desc=移除稿定设计开屏广告、首页轮播图和弹窗，移除功能入口角标。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/v\d\/delivery-pits\/ios-splash\/modules$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/delivery-pits\/(template|mine|home)-page-dialog\/modules$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/cp\/search-words\/v2\/placeholder/i then reject_dict(200)
response if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/template\/resources$/i then response.json.jq(".pits |= map(select(.module_type != \"BANNER\"))")
response if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/app_mine\/resources$/i then response.json.jq(".pits |= map(select(.module_type != \"BANNER\"))")
response if ${url} ~= /^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/(templates|all_editor_tools)\/resources$/i then response.json.jq("walk(if type == \"object\" and .badge_img_url? then .badge_img_url=\"\" else . end)")

[MitM]
hostname=www.gaoding.com
