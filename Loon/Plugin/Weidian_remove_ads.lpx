#!name=微店去广告
#!desc=移除开屏广告、弹窗广告、猜你喜欢、猜你想搜、关注推荐，精简搜索页和我的页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/ares\/home\.splash\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/warlock\/recommend\.guessULike\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/poseidon\/exhibit\.spaceJson\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/ares\/app\.dialog\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/warlock\/recommend\.guessULike\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/feedserver\/feed\.similarRecFeeds\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/faith\/search\.hotRecShadowWord\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/faith\/search\.getProcessTopics\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/feedserver\/feed\.listGoodUsers\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/feedserver\/feed\.myFollow\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/ares\/recommend\.getSpecialFocusList\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/thor\.weidian\.com\/ares\/collect\.recommendShop\//i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/thor\.weidian\.com\/appconf\/getAppConfig\//i then script("https://kelee.one/Resource/JavaScript/Weidian/getAppConfig.js") with tag="配置修改", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/thor\.weidian\.com\/wgs\/wallet\.query\.order\.entrance\//i then script("https://kelee.one/Resource/JavaScript/Weidian/wallet.js") with tag="精简钱包区", requires_body=true, binary_body_mode=true

[MitM]
hostname=thor.weidian.com
