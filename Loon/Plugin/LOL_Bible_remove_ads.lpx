#!name=掌上英雄联盟去广告
#!desc=移除开屏广告、弹窗推广、搜索热搜、搜索热榜、底栏推广图标。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/recommend\/platstrongshell\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/club\/match\/get_ai_search_words$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/mlol_news\/search\/varcache_hotV\d\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/customize_search\/article_rank_tab\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/customize_search\/article_rank\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/zone\/bottomtab_tip\?/i then reject_dict(200)

[MitM]
hostname=mlol.qt.qq.com
