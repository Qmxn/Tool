#!name=智联招聘去广告
#!desc=移除开屏广告、弹窗、职位页面推广和各类横幅推广。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rule]
URL-REGEX, "^https:\/\/(ask|cgate)\.zhaopin\.com\/operation\/ad\/", REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/ask\.zhaopin\.com\/plat-zqa-server\/home\/\d\.\d\.\d\/getHomeContents\?/i then response.json.delete("data.templates[0].data.banner")
request if ${url} ~= /^https:\/\/cgate\.zhaopin\.com\/resumeapi\/resumeCheck\/positionDetailBottomTipCheck$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cgate\.zhaopin\.com\/bdp\/commercial\/queryLinkData$/i then reject(404)

[MitM]
hostname=ask.zhaopin.com, cgate.zhaopin.com
