#!name=美食杰去广告
#!desc=移除开屏广告和信息流广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
response if ${url} ~= /^https:\/\/newapi\.meishi\.cc\/indexnew\/home_feeds/i then response.json.jq("if .data.items then .data.items |= map(select(.type | . != \"101\" and . != \"12\")) else . end")

[MitM]
hostname=newapi.meishi.cc
