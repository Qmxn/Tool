#!name=丰巢去广告
#!desc=移除弹窗，精简首页和生活服务。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/fcboxactivityweb\/api\/v\d\/clientPage\/modulesAggregated\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/fcboxactivityweb\/api\/v\d\/clientPage\/jinGangFirst\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/v2\/home\/mallInfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/dsp\.fcbox\.com\/adSearch\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/hs-portal\/app\/config\/page\/home\/v2\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/post\/suggestion\/query$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/v1\/dynamicConfig\/findTabbarConfig\/mainPage$/i then response.json.delete(["data.lifeService", "data.mall", "data.wash"])
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/fcboxactivityweb\/marketingEntrance\/retentionPopup$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/fcboxactivityweb\/api\/clientPopup\/v\d\/queryPopupWithPriority$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/consumer\.fcbox\.com\/fcboxactivityweb\/api\/guidePopup\/popup$/i then reject_dict(200)

[MitM]
hostname=consumer.fcbox.com, dsp.fcbox.com
