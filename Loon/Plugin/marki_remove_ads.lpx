#!name=马克水印相机去广告
#!desc=移除开屏广告，拍摄首页悬浮挂件，侧边栏横幅广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/marki\.markiapp\.com\/mkg\/MomStats\/getFlowWindowList$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/marki\.markiapp\.com\/mkg\/Advertising\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/marki\.markiapp\.com\/mkg\/MomStats\/getIntegralAdv$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/market-callback\.markiapp\.com\/adcenter\//i then reject_dict(200)

[MitM]
hostname=marki.markiapp.com, market-callback.markiapp.com
