#!name=IPA工具箱助手
#!desc=这是IPA工具箱的辅助插件，用于下载IPA包和应用降级。IPA工具箱是运行在Scripting应用中的脚本，需要购买Scripting的Pro版本才能运行。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Script]
http-request ^https:\/\/apple-api\.com script-path=https://kelee.one/Resource/JavaScript/IPATool/AppStoreAPI.js, requires-body=true, tag=App Store API
http-request ^https:\/\/xiaobai\.app script-path=https://kelee.one/Resource/JavaScript/IPATool/Installer.js, tag=安装器

[MitM]
hostname=apple-api.com, xiaobai.app
