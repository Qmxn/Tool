#!name=摩托范去广告
#!desc=移除开屏广告、弹窗广告、横幅广告、文末广告及相关文章推荐、广告下发，移除我的页面商品推荐，精简搜索页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/api\.58moto\.com\/advert\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.58moto\.com\/mall\/goods\/self\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.58moto\.com\/mall\/goods\/self\/homeList\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22025/i then response.body.mock("json", "{\"code\":0,\"msg\":\"success\"}", 200)
response if ${url} ~= /^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22038/i then response.body.mock("json", "{\"code\":0,\"msg\":\"success\"}", 200)
response if ${url} ~= /^https:\/\/api\.58moto\.com\/forum\/public\/labelController\.do\?action=20112/i then response.body.mock("json", "{\"code\":0,\"msg\":\"success\"}", 200)
response if ${url} ~= /^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22004/i then response.json.delete("data.link")

[Script]
response if ${url} ~= /^https:\/\/api\.58moto\.com\/expands\/config\/appWholeConfig\?key=app_whole_config$/i then script("https://kelee.one/Resource/JavaScript/MotorFans/MotorFans_remove_ads.js") with tag="修改配置", requires_body=true

[MitM]
hostname=api.58moto.com
