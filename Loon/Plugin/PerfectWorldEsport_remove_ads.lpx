#!name=完美世界电竞去广告
#!desc=移除开屏广告，精简搜索页。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
response if ${url} ~= /^https:\/\/api\.wmpvp\.com\/api\/v1\/config\/promote$/i then response.json.delete("data.ad")
request if ${url} ~= /^https:\/\/appactivity\.wmpvp\.com\/hotsearch\/all\?/i then reject_dict(200)

[MitM]
hostname=api.wmpvp.com, appactivity.wmpvp.com
