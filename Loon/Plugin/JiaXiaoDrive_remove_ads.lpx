#!name=驾校一点通去广告
#!desc=移除开屏广告、各页面广告横幅、弹窗广告，移除社区广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/richmanrules\.ksedt\.com\/serverConfig\/3\/adConfig\.json/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gouche\.ksedt\.com\/config\/popup\/info$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/richmanrules\.ksedt\.com\/intellectWaterfallBidding\/find$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/op\.ksedt\.com\/jxedtLive\/liveIntroduceResource/i then reject_dict(200)
request if ${url} ~= /^https:\/\/richmanrules\.ksedt\.com\/intellectWaterfall\/find$/i then reject_dict(200)
response if ${url} ~= /http-response/i then response.json.delete("^https:\\/\\/api\\.ksedt\\.com\\/api\\/config\\/")

[MitM]
hostname=richmanrules.ksedt.com, gouche.ksedt.com, muses.ksedt.com, op.ksedt.com, api.ksedt.com
