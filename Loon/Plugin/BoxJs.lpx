#!name=BoxJs
#!desc=JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js") with tag="BoxJS", timeout=120, requires_body=true

[MitM]
hostname=boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
