#!name=天天跳绳去广告
#!desc=移除开屏广告、横幅广告、弹窗广告、活动推广，精简首页标签和搜索页面。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api\d\/abtest\/ads_v\d\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cdn\.tiantiantiaosheng\.com\/props_config_prod\/ad_position_config\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api\d\/adolescent_mode\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api\d\/ad_sys\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api\/user\/home_page\/activities$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api\d\/search\/base_info$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/medal_challenge_activity\/page_switch\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/training_plan\/recommended_list$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/user\/new_register_info$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/popup\/list\?/i then reject_dict(200)

[MitM]
hostname=api.tiantiantiaosheng.com, cdn.tiantiantiaosheng.com
