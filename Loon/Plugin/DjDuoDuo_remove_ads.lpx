#!name=DJ多多去广告
#!desc=移除开屏广告及歌单广告
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Script]
response if ${url} ~= /^https:\/\/api\.dianyinduoduo\.com\/v4\/config\.php\?/i then script("https://kelee.one/Resource/JavaScript/DjDuoDuo/DjDuoDuo_remove_ads.js") with tag="去广告", requires_body=true

[MitM]
hostname=api.dianyinduoduo.com
