#!name=航旅纵横去广告
#!desc=过滤航旅纵横广告
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rule]
URL-REGEX, "^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native", REJECT

[Script]
response if ${url} ~= /^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/i then script("https://kelee.one/Resource/JavaScript/Umetrip/Umetrip_remove_ads.js") with tag="移除首页广告"

[MitM]
hostname=114.115.217.129, home.umetrip.com
