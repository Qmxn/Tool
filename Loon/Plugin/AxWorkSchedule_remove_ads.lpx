#!name=排班日历去广告
#!desc=移除开屏广告、横幅广告。
#!icon=https://github.com/Qmxn/Tool/raw/X/icon/icon/loonLite.png

[Rewrite]
request if ${url} ~= /^https:\/\/schedule-api\.julanling\.com\/api\d\/get_splash$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/schedule-api\.julanling\.com\/api\d\/index_advert$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/schedule-api\.julanling\.com\/api\d\/queryAdvertConfig$/i then reject_dict(200)

[MitM]
hostname=schedule-api.julanling.com
